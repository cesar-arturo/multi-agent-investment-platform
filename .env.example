# Copy to .env and enter your credentials locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Finnhub company news (free key at https://finnhub.io).
FINNHUB_API_KEY=

# SEC EDGAR requires an identifying User-Agent with a contact email.
SEC_USER_AGENT=YourAppName your-email@example.com
